{
  "kind": "creature",
  "id": "merrin",
  "name": "Merrin",
  "model": "res://art/merrin.glb",
  "abilities": [8, 14, 12, 18, 13, 10],

  // A wizard, so a good Will save and a poor Fortitude — the opposite of what the old
  // hand-written numbers said, and the correct way round.
  "classes": [ { "class": "wizard", "level": 5 } ],

  "skills": [
    { "skill": "Perception", "ranks": 3 },
    { "skill": "Heal", "ranks": 5 },
    { "skill": "Knowledge", "ranks": 8 },
    { "skill": "Spellcraft", "ranks": 8 }
  ],

  "speed": 30,

  // Crossbow first, staff second: the same order the goblin archer uses, and the reason a
  // click on a distant enemy offers the bolt while a click on an adjacent one offers the staff.
  "feats": ["iron-will", "improved-initiative"],
  "items": ["light-crossbow", "quarterstaff"],

  // Order is priority: the AI works down the list, so Cause Fear gets the first-level slot
  // ahead of Magic Missile. A debuff that lasts the fight beats 3d4+3 once.
  "spells": ["fireball", "scorching-ray", "cause-fear", "grease", "magic-missile"]
}
