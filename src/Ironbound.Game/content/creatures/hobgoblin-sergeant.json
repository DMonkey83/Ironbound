// The one that makes the ambush a fight. Base attack 6, so it full attacks back — the same
// step the party just crossed, seen from the other side.
{
  "kind": "creature",
  "id": "hobgoblin-sergeant",
  "name": "Hobgoblin Sergeant",
  // Fighter 6, an adventurer's class, rated one level down.
  "cr": 5,
  "model": "res://art/hobgoblin.glb",
  "abilities": [15, 13, 14, 10, 10, 8],
  "classes": [ { "class": "fighter", "level": 6 } ],

  "skills": [
    { "skill": "Stealth", "ranks": 4 },
    { "skill": "Perception", "ranks": 6 }
  ],
  "speed": 30,
  // Weapon Specialization in the longsword, the one weapon he fights with — and Weapon Focus in
  // it, which the book asks for first and his file was missing until the feats were checked.
  // A fighter 6 has seven feats; he still carries only four of them.
  "feats": ["combat-reflexes", "weapon-focus:longsword", "weapon-specialization:longsword", "power-attack"],

  // A fighter 6 trains in a weapon group at fifth level: the longsword's.
  "weaponTraining": ["heavy-blades"],
  // The silvered blade is on his belt, not in his hand — he has no use for it against
  // three humans. Kill him and it is the answer to what is waiting in the clearing.
  "items": ["chain-shirt", "heavy-shield", "longsword", "silvered-longsword"],

  // NPC gear, by the Bestiary's hobgoblin, and a sergeant's pay in his purse.
  "treasure": "npc-gear",
  "purse": { "gp": "2d6", "sp": "3d10" }
}
