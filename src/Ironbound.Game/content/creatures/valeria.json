{
  "kind": "creature",
  "id": "valeria",
  "name": "Valeria",
  // Fighter 6, rated one level down.
  "cr": 5,
  "model": "res://art/valeria.glb",
  // Intelligence 13 is not decoration: it is what Combat Expertise costs, and what Improved
  // Trip costs on top of that. A fighter who wants to trip people pays for it here.
  "abilities": [18, 14, 14, 13, 12, 10],

  // One fact instead of four. Hit points, base attack and all three saves now follow from it,
  // and cannot drift out of step with each other.
  "classes": [ { "class": "fighter", "level": 6 } ],

  "skills": [
    { "skill": "Perception", "ranks": 4 },
    { "skill": "Intimidate", "ranks": 6 }
  ],

  "speed": 30,
  // A fighter's feats: quick on her feet, punishes anyone who walks past her, and knows
  // how to put somebody on the floor without opening her guard. A human fighter 6 has eight —
  // three for her levels, one for being human, four fighter bonus feats. The eighth is Greater
  // Trip, which her base attack of six has just opened: two more on every trip, and whoever
  // she puts down draws a swing from everyone standing over it on the way to the floor.
  // Weapon Specialization is in the longsword, as the feat is always in one weapon.
  "feats": [
    "dodge", "combat-reflexes", "improved-trip", "weapon-specialization:longsword", "combat-expertise",
    "weapon-focus:longsword", "shield-focus", "greater-trip"
  ],

  // Weapon training at fifth level, in the group her longsword is in.
  "weaponTraining": ["heavy-blades"],
  // Worn and held, rather than a bare "+6 armour" that says nothing about why.
  "items": ["chain-shirt", "heavy-shield", "longsword"]
}
