// Seven hit points. Everything about playing her well follows from that number.
{
  "kind": "creature",
  "id": "sylwen",
  "name": "Sylwen",
  "model": "res://art/merrin.glb",
  // An elf: two more Dexterity and two less Constitution than the human she might have been.
  "abilities": [8, 16, 12, 17, 12, 10],

  // Which is also why the shortbow is hers: an elf is trained with it whatever a wizard is not.
  "race": "elf",
  "classes": [ { "class": "wizard", "level": 1 } ],

  "skills": [
    { "skill": "Knowledge", "ranks": 4 },
    { "skill": "Spellcraft", "ranks": 4 },
    { "skill": "Perception", "ranks": 2 }
  ],
  "speed": 30,
  "feats": ["improved-initiative"],

  // Bow first, so a click on anything at range offers an arrow; the dagger is for when that
  // has gone wrong.
  "items": ["shortbow", "dagger"],

  // One first-level slot from the table and one from Intelligence 17, and a conjuration slot
  // besides, which only grease or mage armour may use. Missiles first: the automatic hand
  // works down the list.
  "spells": ["magic-missile", "grease", "mage-armor"],

  // A conjurer who gave up enchantment and necromancy, so a charm or a fear spell would cost her
  // two slots. The bond is to an object — the bow, as she tells it — worth one spell a day from
  // her book without a slot. Acid dart is the school's: a few times a day once the slots are gone.
  "school": "conjuration",
  "opposition": ["Enchantment", "Necromancy"],
  "arcaneBond": "object"
}
