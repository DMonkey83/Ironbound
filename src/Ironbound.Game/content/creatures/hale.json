// The second rank: armoured like a fighter, and the only one who can close a wound.
{
  "kind": "creature",
  "id": "hale",
  "name": "Hale",
  "model": "res://art/valeria.glb",
  "abilities": [14, 10, 14, 10, 15, 12],
  "classes": [ { "class": "cleric", "level": 1 } ],

  "skills": [
    { "skill": "Heal", "ranks": 4 },
    { "skill": "Knowledge", "ranks": 2 },
    { "skill": "Spellcraft", "ranks": 2 }
  ],
  "speed": 30,
  "feats": ["dodge", "great-fortitude"],

  // Cihua Couatl, the feathered serpent: neutral good, so Hale channels positive energy and
  // casts cures in place of anything prepared. Healing and War are both hers to grant.
  "deity": "cihua-couatl",
  "domains": ["healing", "war"],
  "items": ["scale-mail", "heavy-shield", "light-mace"],

  // Three slots: one from the table, one from Wisdom 15, and the domain slot, which only a
  // Healing or War spell may use — Cure Light Wounds, here. Bless first, because it is the one
  // the automatic hand reaches for when nobody is hurt.
  "spells": ["bless", "cure-light-wounds"]
}
