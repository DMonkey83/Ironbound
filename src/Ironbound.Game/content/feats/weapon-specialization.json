// A fighter's signature: two more damage with one kind of weapon — the one Weapon Focus was
// taken for, and only by somebody with four levels of fighter behind them.
{
  "kind": "feat",
  "id": "weapon-specialization",
  "name": "Weapon Specialization",
  "combat": true,
  "takes": "Weapon",
  "description": "+2 on damage rolls with one kind of weapon.",
  "effect": "WeaponSpecialization",

  // The same weapon as the Weapon Focus: "sameChoice" is what says so.
  "requires": { "feats": ["weapon-focus"], "sameChoice": true, "proficient": true, "classLevels": { "fighter": 4 } }
}
