// Two better at it, and — the part that matters — reaching in no longer costs you a free swing.
{
  "kind": "feat",
  "id": "improved-trip",
  "name": "Improved Trip",
  "combat": true,
  "description": "Tripping does not provoke, and the check is +2.",
  "effect": "ImprovedTrip",

  // A feat that wants a feat. This is what makes a trip specialist a build: two slots spent to
  // get to the one that matters.
  "requires": { "int": 13, "feats": ["combat-expertise"] }
}
