// The iconic trade, and the one the engine had to grow a new idea for: it is not a number you
// can add to a stack, it is a decision you make before every swing.
{
  "kind": "feat",
  "id": "power-attack",
  "name": "Power Attack",
  "combat": true,
  "description": "Trade accuracy for damage on melee attacks. The trade steepens with skill.",
  "effect": "PowerAttack",

  // Strength 13 is what keeps this off the wiry duellist. It is the whole reason an ability
  // score is a build decision rather than a number you round up at creation.
  "requires": { "str": 13, "baseAttack": 1 }
}
