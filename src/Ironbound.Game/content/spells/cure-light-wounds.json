// A healing touch.
{
  "kind": "spell",
  "id": "cure-light-wounds",
  "name": "Cure Light Wounds",
  "level": 1,
  "school": "Conjuration",
  "range": "touch",
  "target": { "shape": "single" },
  "affects": "Allies",

  // A cure spell: what a good cleric may cast in place of anything prepared, and what a Healing
  // cleric's blessing empowers.
  "descriptors": ["cure"],
  "does": [
    // One d8, and one a caster level to a maximum of five: a first-level cleric's cure is 1d8+1.
    { "heal": { "fixed": "1d8", "plusPerLevel": 1, "plusMaximum": 5 } }
  ]
}
