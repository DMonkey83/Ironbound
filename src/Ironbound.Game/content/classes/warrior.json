// The NPC class. Everything a fighter has except the reason to be interesting — which is why
// a goblin warrior and a goblin fighter are different things.
{
  "kind": "class",
  "id": "warrior",
  "name": "Warrior",
  "hitDie": 10,
  "attack": "Full",
  "goodSaves": ["Fortitude"],
  "classSkills": ["Climb", "Intimidate", "Survival", "Swim", "HandleAnimal", "Ride"],
  "keyAbility": "Strength",
  // An NPC class: the Bestiary rates a warrior two levels below the levels it has, where an
  // adventurer's class is rated one below.
  "npc": true,
  "weaponProficiencies": ["simple", "martial"],
  "armourProficiencies": ["light", "medium", "heavy", "shields"]
}
